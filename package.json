{
  "name": "biblioteca-cloudflare-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create biblioteca",
    "db:migrate:local": "wrangler d1 migrations apply biblioteca --local",
    "db:migrate:remote": "wrangler d1 migrations apply biblioteca --remote",
    "db:seed:local": "wrangler d1 execute biblioteca --local --file=./migrations/seed.sql",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
